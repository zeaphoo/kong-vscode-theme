{
  "name": "kong-vscode-theme",
  "displayName": "Kong Theme",
  "description": "Kong theme for VS Code",
  "version": "2.0.0",
  "type": "module",
  "publisher": "zeaphoo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b1f23",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeaphoo/kong-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/zeaphoo/kong-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.43.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "kong",
    "light",
    "dark"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Kong Light",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      },
      {
        "label": "Kong Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      }
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.17.0",
    "@primer/primitives": "7.10.0",
    "chroma-js": "^2.1.2",
    "color": "^3.1.2",
    "vsce": "^1.100.1"
  },
  "scripts": {
    "start": "node --watch src/index.js",
    "build": "node src/index.js && mkdir -p build",
    "package": "vsce package -o ./build/kong-vscode-theme.vsix",
    "prepublishOnly": "npm run build && vsce publish",
    "release": "changeset publish"
  },
  "__metadata": {
    "publisherDisplayName": "Zhuo Wei"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
