{
  "name": "kong-vscode-theme",
  "displayName": "Kong Theme",
  "description": "Kong theme for VS Code",
  "version": "1.0.9",
  "publisher": "zeaphoo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b1f23",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeaphoo/kong-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/zeaphoo/kong-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.43.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "kong",
    "light",
    "dark"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Kong Light",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      },
      {
        "label": "Kong Light Extended",
        "uiTheme": "vs",
        "path": "./themes/light-ex.json"
      },
      {
        "label": "Kong Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      },
      {
        "label": "Kong Dark Extended",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-ex.json"
      }
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.17.0",
    "@primer/primitives": "7.10.0",
    "@types/chroma-js": "^3.1.1",
    "chroma-js": "^2.1.2",
    "color": "^3.1.2",
    "tsx": "^4.20.3",
    "vsce": "^1.100.1"
  },
  "scripts": {
    "start": "tsx watch src src/index.ts",
    "build": "npx tsx src/index.ts && mkdir -p build",
    "package": "vsce package -o ./build/kong-vscode-theme.vsix",
    "prepublishOnly": "npm run build && vsce publish",
    "release": "changeset publish"
  },
  "__metadata": {
    "publisherDisplayName": "Zhuo Wei"
  },
  "publishConfig": {
    "access": "public"
  }
}
